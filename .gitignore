# === Secrets — keep these first, they matter most ===
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.mobileprovision
*.jks
*.keystore
google-services.json
GoogleService-Info.plist
credentials.json

# === Dependencies ===
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# === Expo ===
.expo/
dist/
web-build/
expo-env.d.ts

# === Native builds ===
# Generated by `expo prebuild` — regenerate rather than commit.
# If you ever adopt bare workflow and hand-edit native code, remove these two lines.
/ios
/android
*.ipa
*.apk
*.aab
*.tar.gz

# === Metro ===
.metro-health-check*
.metro-cache/

# === Native tooling ===
*.orig.*
*.jsbundle
Pods/
.gradle/
local.properties

# === Testing ===
coverage/
.nyc_output/

# === Logs ===
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# === Data work (Track A) ===
# RxNorm releases are large and licensed — never commit them.
data/raw/
data/rrf/
*.RRF
*.zip
# The pruned SQLite is a build artifact; regenerate from scripts.
data/*.sqlite
data/*.db

# === Editors ===
.vscode/
.idea/
*.swp
*.swo

# === OS ===
.DS_Store
Thumbs.db

# === Working files, not deliverables ===
# Body text for the current pull request. Regenerated per PR, stale the moment
# one merges — passed to `gh pr create --body-file`, never committed.
PR_DESCRIPTION.md

# Python bytecode from the Track A scripts
__pycache__/
*.pyc
